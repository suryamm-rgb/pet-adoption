NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/pet-platform
JWT_SECRET=change-me
CLIENT_URL=http://localhost:3000

# Razorpay: leave empty in development for MOCK mode. Test keys (rzp_test_...) are free:
# Dashboard > Settings > API Keys. Webhook: Settings > Webhooks > URL https://<api-host>/api/webhooks/razorpay,
# events payment.captured, payment.failed, refund.processed, with the secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email (Nodemailer). Leave SMTP_HOST empty in development to log emails instead of sending.
# Gmail: smtp.gmail.com / 587 / your address / an App Password. Or Brevo, SendGrid, SES, Mailtrap.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PawStay <no-reply@yourdomain.com>

# Error monitoring (optional): create a Node project at sentry.io (free plan) and paste its DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Image storage. With these three set, ALL uploads go to Cloudinary (free plan is enough to start):
# cloudinary.com > Dashboard > API Keys. Without them, files are saved on this server's disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phone verification (SMS) and WhatsApp alerts, both through Twilio (twilio.com). Leave empty to turn them off.
# In development without these, verification codes are shown on screen and WhatsApp is skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=            # your Twilio phone number, e.g. +15551234567
TWILIO_WHATSAPP_FROM=       # e.g. +14155238886 (Twilio sandbox) or your approved WhatsApp sender
REQUIRE_PHONE_VERIFICATION=false   # true: caretakers must verify their phone before they can be approved

# Browser push notifications. Generate keys once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# Google sign-in: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web).
# Add your site (https://yourdomain.com and http://localhost:3000) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Caretaker payouts: manual = the admin transfers by bank. route = automatic Razorpay Route transfers (needs Route enabled on your Razorpay account).
PAYOUT_MODE=manual
